<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-faxprint">
    <comment>Faxprint-File</comment>
    <sub-class-of type="application/pdf"/>
    <sub-class-of type="image/tiff"/>
    <glob pattern="*.pdf"/>
    <glob pattern="*.g3"/>
    <glob pattern="*.tiff"/>
    <glob pattern="*.tif"/>
    <glob pattern="*.doc"/>
    <glob pattern="*.docx"/>
    <glob pattern="*.html"/>
  </mime-type>
</mime-info>
